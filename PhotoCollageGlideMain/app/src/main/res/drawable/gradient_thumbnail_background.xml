<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle shadow -->
    <item android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    
    <!-- Main thumbnail background -->
    <item android:bottom="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F0F5F5F5"
                android:centerColor="#F8F8F8F8"
                android:endColor="#F0F5F5F5"
                android:angle="45" />
            <corners android:radius="8dp" />
            <stroke 
                android:width="1dp" 
                android:color="#40000000" />
        </shape>
    </item>
    
    <!-- Glossy top highlight -->
    <item 
        android:bottom="1dp" 
        android:left="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>